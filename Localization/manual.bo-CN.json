  "cycle": ["བརྗེ་སྐོར་གོ་རིམ།", "འཆར་གཞི་མང་པོ་རང་འགུལ་བརྗེ་བ།", "1. HUD སྒྲིག་འགོད་ནང་འཆར་གཞི་གོ་རིམ་ནང་སྣོན།\n2. གོང་སྤོ་དང་འོག་སྤོ་ཡིས་གོ་རིམ་བཅོས།\n3. རང་འགུལ་བརྗེ་སྐོར་སྒོ་ཕྱེ་ནས་བར་ཐག་དང་འགུལ་རིས་སྒྲིག་ཅིང་ཉར།", "གོ་རིམ་སྟོང་པ་ཡིན་ན་མི་བརྗེ། གཅིག་ཁོ་ན་ཡོད་ན་དེ་རང་སྟོན། རྒྱུན་སྟོན་ HUD མནན་ནས་བརྗེ་བ་སྒོ་ཕྱེ་ཐུབ། མནན་ན་རང་འགུལ་བརྗེ་སྐོར་དུས་ཚད་བསྐྱར་འགོ་རྩོམ།"],
  "summons": ["མྱུར་མཐེབ་དང་སློང་ས།", "HUD སྟོན་པ། སྦས་པ་དང་ཙིག་རྟགས་ཀྱིས་སློང་བ།", "1. སྟོན་སྦས་མྱུར་མཐེབ་སྒྲིག་ཅིང་ཆ་ཚང་ངམ་བསྡུས་པའི་འགུལ་རིས་འདེམས།\n2. རྒྱུན་དུ་སྟོན་པ་བརྒྱབ་ནས་ཙིག་རྟགས་ས་ཁུལ་སྒོ་ཕྱེ།\n3. ས་ཁུལ་གནས་ས། ཆེ་ཆུང་། སྤོ་ཚད་དང་སྡོད་ཡུན་སྒྲིག་ནས་ཉར།", "Ctrl ཡང་ན་ Alt དང་ལྷན་དུ་ཡིག་འབྲུ། ཨང་ཀི་ཡང་ན་བྱེད་ནུས་མཐེབ་སྤྱོད། F12 མི་ཆོག སྦས་དུས་རང་འགུལ་སློང་བ་གནས་སྐབས་འགོག སླར་མནན་ན་སྔའི་འཆར་སྟངས་སོར་ཆུད།"],
  "triggers": ["སློང་བའི་སྒྲིག་སྲོལ།", "གཞི་གྲངས་ཆ་རྐྱེན་ལྟར་ HUD སློང་བ།", "1. HUD ནང་དོན་གྱི་སློང་བའི་སྒྲིག་སྲོལ་ཁ་ཕྱེ་ནས་གསར་པ་སྣོན།\n2. ལྟ་ཞིབ་འགྱུར་ཚད། ཆ་རྐྱེན། བསྡུར་རྟགས་དང་མཚམས་ཐང་སྒྲིག\n3. བསྐྱར་སློང་བར་ཐག་སྒྲིག་ཅིང་སྒོ་ཕྱེ་ནས་ཉར།", "རྒྱུན་དུ་སྟོན་པ་བརྒྱབ་དུས་ཁོ་ན་སྤྱོད་ཐུབ། ཐང་འགྱུར་བ། བདེན་པར་འགྱུར་བ་དང་མཚམས་ཐང་བསྡུར་བ་འདེམས་ཐུབ། ཐོག་མའམ་བསྐྱར་ཐོབ་ཀྱི་དཔེ་ལེན་གྱིས་གཞི་ཐང་ཁོ་ན་འཛུགས།"],
  "special": ["དམིགས་བསལ་འཆར་གཞི།", "འཛམ་གླིང་ཆུ་ཚོད། དྲ་རྒྱ་དང་ལྡེབ་ཚད་སྒྲིག", "1. འཛམ་གླིང་ཆུ་ཚོད་ནང་ UTC དུས་ཁུལ་དང་ཉིན་རེའི་དམིགས་ཚོད་སྒྲིག\n2. དྲ་རྒྱའི་མྱུར་ཚད་ནང་འཇལ་བྱེད་དང་ 100% གཞི་འཛིན་མྱུར་ཚད་སྒྲིག\n3. ལྡེབ་ཚད་ནང་འཆར་ཆས་སམ་སྒེའུ་ཁུང་འདེམས་ནས་ཉར།", "འཛམ་གླིང་ཆུ་ཚོད་ཀྱིས་གཏན་འཇགས་དུས་ཁུལ་སྤྱོད། དབྱར་དུས་རང་འགུལ་མི་བརྗེ། ལྡེབ་ཚད་ནི་དངོས་སུ་སྟོན་པའི་ལྡེབ་ཚད་ཡིན། འཆར་ཆས་གསར་འདོན་ཟློས་ཕྱོད་མིན།"],
  "media": ["བརྒྱུད་གཟུགས།", "ད་ལྟ་སྟོན་བཞིན་པའི་གླུ་དབྱངས་དང་སྒྲའི་གནས་ཚུལ།", "1. Windows བརྒྱུད་གཟུགས་ཚོད་འཛིན་རྒྱབ་སྐྱོར་ཡོད་པའི་སྟོན་ཆས་ཁ་ཕྱེ།\n2. འགྱུར་ཚད་མཛོད་ནང་བརྒྱུད་གཟུགས་འགྱུར་ཚད་འཚོལ།\n3. ཁ་བྱང་། སྒྱུ་རྩལ་པའམ་འཕེལ་ཚད་ HUD དཔེ་གཞིར་སྦྱར།", "མཉེན་ཆས་ཀྱིས་གཞི་གྲངས་མཁོ་སྤྲོད་བྱེད་དགོས། སྟོན་བཞིན་མེད་པ་དང་རྒྱབ་སྐྱོར་མེད་ན་གཞི་གྲངས་མེད་སྲིད། གསར་འདོན་མགྱོགས་ཚད་སྟོན་ཆས་ལ་བརྟེན།"],
  "instances": ["HUD དཔེ་ཚན་མང་པོ།", "རང་རང་གི་ནང་དོན་དང་གནས་ས་ཡོད་པའི་ HUD མང་པོ་བཟོ་བ།", "1. ཚོད་ལྟའི་བྱེད་ནུས་ནང་ HUD དཔེ་ཚན་མང་པོ་སྒོ་ཕྱེ།\n2. HUD སྣོན་ནས་མིང་སྤྲོད། དཔེ་ཚན་འདེམས་ནས་ཐོག་མའི་ཤོག་བྱང་གཉིས་ནང་བཅོས།\n3. ཉར་ནས་སྤྱོད་ལ་མནན། གནས་ས་འཚོལ་བའི་མཐེབ་ཀྱིས་བདམས་པའི་ HUD ལ་སྤོ།", "HUD མང་ཤོས་ 16 ཡོད་ཐུབ། སྒྲིག་འགོད་ཁ་ཕྱེ་རིང་བདམས་པའི་ HUD ལ་ལི་མདོག་མཐའ་སྟོན། དཔེ་ལེན་བར་ཐག་དང་མནན་ནས་བརྗེ་བ་མཉམ་སྤྱོད་ཡིན། སྐད་ཡིག་དང་འགོ་རྩོམ་སྒྲིག་འགོད་ཀྱང་སྤྱི་ཡོངས་ཡིན།"],
  "maintenance": ["བདག་སྐྱོང་དང་གྲབས་ཉར།", "སྒྲིག་འགོད་ཕྱིར་འདྲེན། ནང་འདྲེན་དང་སོར་ཆུད།", "1. སྐོར་གྱི་ཤོག་བྱང་ནང་སྒྲིག་འགོད་ཕྱིར་འདྲེན་ནས་གྲབས་ཉར་བྱོས།\n2. ནང་འདྲེན་སྤྱོད་ནས་སྔའི་སྒྲིག་འགོད་སོར་ཆུད་བྱོས།\n3. ཟིན་ཐོ་ཡིག་སྣོད་ཁ་ཕྱེ་ནས་སྐྱོན་འཚོལ་ཞིང་གསར་བཅོས་ཞིབ་བཤེར་བྱོས།", "ནང་འདྲེན་གོང་ད་ལྟའི་སྒྲིག་འགོད་གྲབས་ཉར་བྱེད། ཚང་མ་སོར་བཞག་བྱས་ན་ཉར་ནས་སྤྱོད་ལ་མནན་དགོས། སྒྲིག་འགོད་སྤོ་དུས་ API གསང་ལྡེ་བསྐྱར་འཇུག་དགོས་སྲིད།"],
  "troubleshooting": ["སྐྱོན་འཚོལ།", "གཞི་གྲངས་མེད་པ་དང་སྤྱོད་མི་ཐུབ་པའི་གནད་དོན་བཅོས་པ།", "1. HUD སྤྱིའི་སྒོ། དམིགས་འཆར་ཆས། མྱུར་མཐེབ་སྦས་པ་དང་འཆར་གཞི་འདེམས་ཀ་ཞིབ་བཤེར།\n2. སྲ་ཆས་དབང་ཆ། སྐུལ་འདེད་ཆས་དང་ཕྱིའི་འབྱུང་ཁུངས་ཞིབ་བཤེར།\n3. ཟིན་ཐོ་དང་སྲ་ཆས་བརྟག་དཔྱད་ཕྱིར་འདྲེན་ནས་སྐྱོན་འཚོལ། ལམ་སྟོན་ནང་འགྱུར་ཚད་མིང་འཚོལ་ཐུབ།", "གཞི་གྲངས་བརྡའི་རྟགས་འདེམས་སྤྱད་ན་སྒེའུ་ཁུང་དེར་བཀོད་པའི་འགྱུར་ཚད་ཁོ་ནའི་བརྡ་རྒྱུན་དུ་འགོག འགྱུར་ཚད་གཞན་ལ་བརྡ་གཏོང་རྒྱུ་ཡིན། ཚོར་ཆས་རྒྱབ་སྐྱོར་མེད་ན་དབང་ཆ་སྣོན་ཀྱང་གཞི་གྲངས་མི་ཐོབ།"]
