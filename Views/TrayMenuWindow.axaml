<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EndfieldChargePlus.Views.TrayMenuWindow"
        Width="220" Height="139"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        SystemDecorations="None"
        CanResize="False"
        Focusable="True">
  <Border CornerRadius="10"
          Background="#1E1E20"
          Padding="6"
          BoxShadow="0 4 20 #40000000"
          BorderThickness="1"
          BorderBrush="#2A2A2C">
    <StackPanel Spacing="2" VerticalAlignment="Center">
      <Border x:Name="MenuPreview"
              Height="36"
              CornerRadius="6"
              Padding="12,0"
              Cursor="Hand"
              Background="Transparent">
        <TextBlock x:Name="MenuPreviewText"
                   Text="预览 HUD"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Foreground="#E8E8E8"/>
      </Border>

      <Border x:Name="MenuSettings"
              Height="36"
              CornerRadius="6"
              Padding="12,0"
              Cursor="Hand"
              Background="Transparent">
        <TextBlock x:Name="MenuSettingsText"
                   Text="设置"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Foreground="#E8E8E8"/>
      </Border>

      <Border Height="1" Background="#2A2A2C" Margin="8,4"/>

      <Border x:Name="MenuExit"
              Height="36"
              CornerRadius="6"
              Padding="12,0"
              Cursor="Hand"
              Background="Transparent">
        <TextBlock x:Name="MenuExitText"
                   Text="退出"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Foreground="#E8E8E8"/>
      </Border>
    </StackPanel>
  </Border>
</Window>
