<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="EndfieldChargePlus.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="EcpCanvas">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="EcpSidebar">#1B1B1B</SolidColorBrush>
    <SolidColorBrush x:Key="EcpCard">#202020</SolidColorBrush>
    <SolidColorBrush x:Key="EcpInput">#171717</SolidColorBrush>
    <SolidColorBrush x:Key="EcpHover">#2E2E2E</SolidColorBrush>
    <SolidColorBrush x:Key="EcpBorder">#3B3B3B</SolidColorBrush>
    <SolidColorBrush x:Key="EcpText">#F2F2F2</SolidColorBrush>
    <SolidColorBrush x:Key="EcpMuted">#A1A1A1</SolidColorBrush>
    <SolidColorBrush x:Key="EcpAccent">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="EcpOnAccent">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="EcpSelection">#28FFFA00</SolidColorBrush>
    <CornerRadius x:Key="EcpRadius">4</CornerRadius>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush">#343400</SolidColorBrush>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush">#454600</SolidColorBrush>
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush">#555600</SolidColorBrush>
    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush">#303030</SolidColorBrush>
    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush">#3A3A3A</SolidColorBrush>
    <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush">#F2F2F2</SolidColorBrush>

    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled">#A1A1A1</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled">#303030</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled">#505050</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled">#A1A1A1</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled">#303030</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled">#505050</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked">#171717</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked">#777777</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver">#171717</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed">#171717</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed">#FFFA00</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled">#202020</SolidColorBrush>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled">#505050</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver">#141414</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed">#141414</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FFFA00" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="ListBoxItem"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <Style Selector="ComboBoxItem"><Setter Property="Transitions" Value="{x:Null}" /></Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource EcpInput}" />
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="Background" Value="{DynamicResource EcpCard}" />
      <Setter Property="BorderBrush" Value="#A5A5AD" />
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource EcpAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
    </Style>
    <Style Selector="ComboBox:disabled">
      <Setter Property="Background" Value="{DynamicResource EcpInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource EcpMuted}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
      <Setter Property="Background" Value="{DynamicResource EcpCard}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
      <Setter Property="Background" Value="{DynamicResource EcpSelection}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource EcpAccent}" />
      <Setter Property="Background" Value="{DynamicResource EcpSelection}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource EcpInput}" />
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="BorderBrush" Value="#898991" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource EcpAccent}" />
    </Style>
    <Style Selector="TextBox:disabled">
      <Setter Property="Background" Value="{DynamicResource EcpInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource EcpMuted}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource EcpInput}" />
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="NumericUpDown:pointerover">
      <Setter Property="BorderBrush" Value="#898991" />
    </Style>
    <Style Selector="NumericUpDown:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource EcpAccent}" />
    </Style>
    <Style Selector="NumericUpDown:disabled">
      <Setter Property="Background" Value="{DynamicResource EcpInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource EcpMuted}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Foreground" Value="{DynamicResource EcpText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="BorderBrush" Value="#8A8A92" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource EcpMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EcpBorder}" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="CornerRadius" Value="1" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="CheckBox:indeterminate /template/ Path#CheckGlyph">
      <Setter Property="Data" Value="M0,0 H10 V2 H0 Z" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="2" />
    </Style>
    <Style Selector="Window">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- Filee Soft timing: quick colour feedback with a softer press transition. -->
    <Style Selector="Button">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions></Setter>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <Style Selector="Button"><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#303030" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#343400" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#454600" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#555600" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#303030" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#343400" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#454600" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
    <Style Selector="ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#555600" /><Setter Property="Foreground" Value="#F2F2F2" /></Style>
  </Application.Styles>
</Application>