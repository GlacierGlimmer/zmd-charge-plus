<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <RootNamespace>EndfieldChargePlus</RootNamespace>
    <AssemblyName>EndfieldChargePlus</AssemblyName>
    <Product>Endfield Charge Plus</Product>
    <Title>Endfield Charge Plus</Title>
    <Company>GlacierGlimmer_冰川雪貓</Company>
    <Authors>GlacierGlimmer_冰川雪貓</Authors>
    <Copyright>© 2026 GlacierGlimmer_冰川雪貓</Copyright>
    <Description>Configurable Endfield-style HUD for Windows</Description>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tray_bolt.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**;artifacts\**;publish\**;packaging\**;scripts\localization\catalog\**" />
    <Compile Remove="Customization\Linux*.cs;Interop\LinuxDesktop.cs" />
    <AvaloniaResource Include="Assets\tray_bolt.png" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/reviewed-language-catalog.json" WithCulture="false" LogicalName="EndfieldChargePlus.LanguageCatalog" />
    <EmbeddedResource Include="Localization/*.json" Exclude="Localization/reviewed-*.json" WithCulture="false" LogicalName="EndfieldChargePlus.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/china-holidays.json" LogicalName="EndfieldChargePlus.china-holidays.json" />
    <EmbeddedResource Include="Assets/PresentMon/ECPFrames-x64.exe" LogicalName="EndfieldChargePlus.PresentMon" />
    <EmbeddedResource Include="Assets/PresentMon/ECPFrames-arm64.exe" LogicalName="EndfieldChargePlus.PresentMon.Arm64" />
    <EmbeddedResource Include="Assets/PresentMon/LICENSE.txt" LogicalName="EndfieldChargePlus.PresentMon.License" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets/Fonts/OFL-NotoSerifTibetan.txt" Link="licenses/NotoSerifTibetan-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
