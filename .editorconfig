root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,axaml,csproj,json,yml,yaml,md}]
end_of_line = lf

[*.cs]
indent_style = space
indent_size = 4

[*.{axaml,csproj,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.bat]
charset = latin1
end_of_line = crlf
