<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">
  <Color x:Key="Hud.Pill">#FF312F30</Color>
  <Color x:Key="Hud.IconPlate">#FFE9E7E4</Color>
  <Color x:Key="Hud.BoltDark">#FF141313</Color>
  <Color x:Key="Hud.TextPrimary">#FFFFFFFF</Color>
  <x:Double x:Key="Hud.TextSecondaryOpacity">0.55</x:Double>
  <x:Double x:Key="Hud.TextTertiaryOpacity">0.40</x:Double>
  <Color x:Key="Hud.Accent">#FFC6CA4C</Color>
  <Color x:Key="Hud.BadgeDark">#FF262425</Color>
  <sys:Double x:Key="Hud.PillRadius">43</sys:Double>
  <FontFamily x:Key="Hud.FontFamily">Inter, "Microsoft YaHei UI", "PingFang SC", sans-serif</FontFamily>
  <FontFamily x:Key="Hud.FontFamilyNumeric">"Inter Medium", Inter, "Microsoft YaHei UI", "PingFang SC", sans-serif</FontFamily>
</ResourceDictionary>
